# Copy to `.env` and adjust. These are the values for a LOCAL run
# (`manage.py runserver` + local Redis/Postgres).
#
# Under Docker Compose you can leave most of them as-is: compose overrides
# POSTGRES_HOST, REDIS_URL and STOCKFISH_PATH per service so the containers reach
# each other by service name. See docs/configuration.md.

# --- Core ------------------------------------------------------------------
# Django secret key. Generate one for anything that isn't local development:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Debug mode: true/false. Must be false in production.
DEBUG=true

# Comma-separated allowed hosts.
ALLOWED_HOSTS=*

# Comma-separated origins trusted by Django's CSRF check, scheme included
# (e.g. https://coach.example.com). Needed behind a TLS-terminating proxy.
CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM (OpenRouter) ------------------------------------------------------
# Optional, but the coach has no other LLM provider: leave it empty and every
# analysis completes on Stockfish-only text, with no coaching prose. Create a key
# at https://openrouter.ai/keys. Usage is billed per request, and each analysed
# move is one request. Never commit the filled-in .env.
OPENROUTER_API_KEY=

# Model slug sent with each request; browse them at https://openrouter.ai/models.
# Nothing to download — change it and restart. Mind that this is charged on every
# analysed move, so a cheaper model is a real saving on a long game.
LLM_MODEL=anthropic/claude-sonnet-4.5

# --- Celery / Redis --------------------------------------------------------
# Broker and result backend. In Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Stockfish -------------------------------------------------------------
# Path to the engine binary. A bare name is looked up on PATH; the leading "./"
# makes it a path to the binary downloaded into the repo root (see
# docs/configuration.md). In Docker it is baked into the image.
STOCKFISH_PATH=./stockfish

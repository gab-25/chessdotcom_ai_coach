# Copy to `.env` and adjust. These are the values for a LOCAL run
# (`manage.py runserver` + local Redis/Postgres/llama-server).
#
# Under Docker Compose you can leave most of them as-is: compose overrides
# POSTGRES_HOST, LLM_BASE_URL, REDIS_URL and STOCKFISH_PATH per service so the
# containers reach each other by service name. See docs/configuration.md.

# --- Core ------------------------------------------------------------------
# Django secret key. Generate one for anything that isn't local development:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Debug mode: true/false. Must be false in production.
DEBUG=true

# Comma-separated allowed hosts.
ALLOWED_HOSTS=*

# Comma-separated origins trusted by Django's CSRF check, scheme included
# (e.g. https://coach.example.com). Needed behind a TLS-terminating proxy.
CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM (llama.cpp llama-server, OpenAI-compatible) ------------------------
# Base URL of the completions endpoint. In Docker: http://llm:8080/v1
LLM_BASE_URL=http://localhost:8080/v1

# Model name sent with each request. llama-server serves whatever model it was
# started with, so this is mostly a label.
LLM_MODEL=llama-3.2-3b-instruct

# --- Celery / Redis --------------------------------------------------------
# Broker and result backend. In Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Stockfish -------------------------------------------------------------
# Path to the engine binary. A bare name is looked up on PATH; the leading "./"
# makes it a path to the binary downloaded into the repo root (see
# docs/configuration.md). In Docker it is baked into the image.
STOCKFISH_PATH=./stockfish
